---
import PostList from './PostList.astro';
import type { Post } from '../lib/posts';
interface Props { posts: Post[]; }
const { posts } = Astro.props;
const groups = new Map<number, Post[]>();
for (const post of posts) { const year = post.data.date.getUTCFullYear(); groups.set(year, [...(groups.get(year) ?? []), post]); }
---
<div class="page-content" data-pagefind-ignore>{[...groups].map(([year, entries]) => <section class="archive-year"><h2>{year}<span class="status-dot" style="margin-left:12px;vertical-align:middle"></span></h2><PostList posts={entries} compact /></section>)}{!posts.length && <p class="empty-state">还没有记录，慢慢来。</p>}</div>
