{
  "name": "jesse-personal-log",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "server": "astro dev",
    "check": "astro check",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "new": "node scripts/new-post.mjs",
    "verify": "node scripts/verify-build.mjs",
    "test:publication": "node scripts/test-publication.mjs",
    "vault:pack": "node scripts/pack-vault.mjs --password-stdin",
    "test:vault": "node --test tests/vault.test.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.2",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.6",
    "dompurify": "3.4.16",
    "katex": "0.19.0",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "linkedom": "0.18.13",
    "pagefind": "1.5.2",
    "typescript": "6.0.3"
  },
  "overrides": {
    "katex": "$katex"
  }
}
