---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, taxonomy } from '../../lib/posts';
import { topicLabel } from '../../config';
export async function getStaticPaths() { return taxonomy(await getPosts(), 'categories').map(([category, posts]) => ({ params: { category }, props: { category, posts } })); }
const { category, posts } = Astro.props;
---
<BaseLayout title={topicLabel(category)}><div data-pagefind-ignore><PageHeader title={topicLabel(category)} eyebrow="EXPLORE / TOPIC" description={`这里放着 ${posts.length} 篇相关记录。`} /><div class="page-content"><PostList posts={posts} /></div></div></BaseLayout>
