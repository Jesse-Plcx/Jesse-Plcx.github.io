---
import { render } from 'astro:content';
import PostLayout from '../layouts/PostLayout.astro';
import { getPosts, postPath } from '../lib/posts';
export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: postPath(post).slice(1, -1) },
    props: { post, previous: posts[i + 1], next: posts[i - 1] },
  }));
}
const { post, previous, next } = Astro.props;
const { Content, headings } = await render(post);
---
<PostLayout post={post} headings={headings} previous={previous} next={next}><Content /></PostLayout>
