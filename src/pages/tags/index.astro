---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getPosts, taxonomy } from '../../lib/posts';
import { topicLabel } from '../../config';
const tags = taxonomy(await getPosts(), 'tags');
---
<BaseLayout title="标签"><div data-pagefind-ignore><PageHeader title="从一个关键词开始。" eyebrow="EXPLORE / TAGS" description="给随手写下的东西，留几个方便找到的线索。" /><div class="tag-index">{tags.map(([value, posts]) => <a href={`/tags/${encodeURIComponent(value)}/`}>#{topicLabel(value)}<span>{String(posts.length).padStart(2,'0')}</span></a>)}</div></div></BaseLayout>
