---
interface Props { title: string; eyebrow?: string; description?: string; }
const { title, eyebrow = 'THE NOTEBOOK', description } = Astro.props;
---
<header class="page-header" data-pagefind-ignore><p class="eyebrow">{eyebrow}</p><h1>{title}</h1>{description && <p>{description}</p>}<slot /></header>
